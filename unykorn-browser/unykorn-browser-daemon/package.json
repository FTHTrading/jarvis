{
  "name": "unykorn-browser-daemon",
  "version": "0.1.0",
  "description": "Unykorn Browser Agent daemon — bridges extension to OpenClaw / LLM.",
  "main": "dist/index.js",
  "scripts": {
    "dev":   "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
