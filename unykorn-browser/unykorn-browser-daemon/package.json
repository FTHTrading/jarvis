    "axios":       "^1.7.2",
    "body-parser": "^1.20.2",
    "cors":        "^2.8.5",
    "dotenv":      "^16.4.5",
    "express":     "^4.19.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors":        "^2.8.17",
    "@types/express":     "^4.17.21",
    "@types/node":        "^20.14.9",
    "ts-node-dev":        "^2.0.0",
    "typescript":         "^5.5.3"
  },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
