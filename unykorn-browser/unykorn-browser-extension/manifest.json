{
  "manifest_version": 3,
  "name": "Unykorn Browser Layer",
  "description": "Unykorn.ai sovereign browser agent — agentic, Web3-aware, wired into OpenClaw.",
  "version": "0.1.0",

  "icons": {
    "16":  "public/icon16.png",
    "48":  "public/icon48.png",
    "128": "public/icon128.png"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel",
    "tabs"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js":      ["src/contentScript.ts"],
      "run_at":  "document_idle"
    }
  ],

  "action": {
    "default_title": "Unykorn Agent",
    "default_popup": "src/popup.html"
  },

  "side_panel": {
    "default_path": "src/sidebar.html"
  },

  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },

  "commands": {
    "toggle-sidebar": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description":   "Toggle Unykorn Agent sidebar"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["src/sidebar.html", "public/*"],
      "matches":   ["<all_urls>"]
    }
  ]
}
