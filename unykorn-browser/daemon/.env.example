# Unykorn Browser Daemon — copy to .env in this directory or repo root

# HTTP server (extension posts here)
UNYKORN_DAEMON_HOST=127.0.0.1
UNYKORN_DAEMON_PORT=8787

# OpenClaw gateway (Primary PC)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
UNYKORN_OPENCLAW_AGENT=main

# Fallback when OpenClaw CLI/gateway unavailable
OPENAI_API_KEY=
UNYKORN_LLM_MODEL=gpt-4o-mini

# Prefer openclaw | openai | auto
UNYKORN_BRAIN=auto
