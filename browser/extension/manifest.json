{
  "manifest_version": 3,
  "name": "Unykorn Sovereign Browser",
  "short_name": "Unykorn",
  "version": "0.1.0",
  "description": "Agentic, Web3-native browser layer wired into the UnyKorn / OpenClaw mesh.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title":  "Unykorn Agent",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel",
    "tabs"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac":     "Command+Shift+U"
      },
      "description": "Toggle Unykorn Agent sidebar"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      }
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["sidebar/sidebar.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
