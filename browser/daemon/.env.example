# Unykorn Sovereign Browser daemon configuration.

# Daemon listen port (extension talks to http://127.0.0.1:UNYKORN_DAEMON_PORT)
UNYKORN_DAEMON_PORT=18790

# OpenClaw / Unykorn mesh gateway (same one Jarvis uses).
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Optional shared secret. If set, the extension must send X-Unykorn-Token: <token>.
UNYKORN_DAEMON_TOKEN=

# Fallback brain when OpenClaw is unreachable. Either openai or none.
UNYKORN_FALLBACK_BRAIN=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS: comma-separated extension IDs / origins allowed to call the daemon.
# Use "*" during dev. Lock to chrome-extension://<your-id> in production.
UNYKORN_DAEMON_CORS=*

# Identity binding (NIL33 / Troptions). Optional — leave blank to disable.
NIL33_API_URL=
NIL33_API_KEY=
