# ── LLM provider (pick one) ───────────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Local Ollama (no key needed)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# ── LLM routing ───────────────────────────────────────────────────────────────
# Which brain to use: openclaw | openai | anthropic | ollama
# openclaw = routes through your local OpenClaw gateway at :18789 (default for UnyKorn)
# openai   = direct OpenAI call (needs OPENAI_API_KEY)
# ollama   = local Ollama, no key needed (needs OLLAMA_MODEL running)
DAEMON_BRAIN=openclaw
# Fallback if primary brain is unreachable (openclaw → ollama is a common pair)
DAEMON_FALLBACK_BRAIN=ollama

# ── OpenClaw mesh ─────────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEFAULT_AGENT=main

# ── NIL33 / Troptions graph (optional) ───────────────────────────────────────
NIL33_API_URL=
NIL33_API_KEY=

# ── Daemon ────────────────────────────────────────────────────────────────────
DAEMON_PORT=40201
DAEMON_LOG_LEVEL=info
# Comma-separated allowed origins (extension IDs)
DAEMON_ALLOWED_ORIGINS=chrome-extension://,moz-extension://
