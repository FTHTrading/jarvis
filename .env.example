# =============================================================================
# Jarvis configuration. Copy this file to `.env` and fill in what you want.
# =============================================================================

# --- LLM "brain" (required for conversation) ---------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any chat-completions model works. gpt-4o-mini is cheap and fast.
JARVIS_LLM_MODEL=gpt-4o-mini

# Or use a local model via Ollama (https://ollama.com). If set, Ollama is used
# instead of OpenAI for the brain. Example: llama3.1, qwen2.5, mistral.
# JARVIS_OLLAMA_MODEL=
# JARVIS_OLLAMA_HOST=http://localhost:11434

# --- Text-to-Speech (pick ONE; ElevenLabs sounds the most human) -------------
# 1) ElevenLabs (recommended for lifelike voice)
#    Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Default "Adam" voice. Browse voices at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5

# 2) OpenAI TTS (good quality, uses OPENAI_API_KEY above).
#    Voices: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer.
JARVIS_OPENAI_TTS_VOICE=onyx
JARVIS_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Which TTS engine to use: "elevenlabs", "openai", or "pyttsx3" (offline).
# "auto" picks the best available based on which API keys are set.
JARVIS_TTS=auto

# --- Speech-to-Text ----------------------------------------------------------
# "whisper-local" runs faster-whisper on your machine (no API cost).
# "whisper-api"   uses OpenAI's hosted Whisper (needs OPENAI_API_KEY).
JARVIS_STT=whisper-local
# Local Whisper model size: tiny | base | small | medium | large-v3
JARVIS_WHISPER_MODEL=base.en

# --- Wake word ---------------------------------------------------------------
# "openwakeword" listens continuously for "Hey Jarvis".
# "ptt" (push-to-talk) records when you press Enter.
# "off" disables mic input entirely (text chat only).
JARVIS_WAKE=ptt

# --- Personality -------------------------------------------------------------
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Sir
