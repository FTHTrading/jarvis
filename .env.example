# =============================================================================
# Jarvis configuration. Copy this file to `.env` and fill in what you want.
# =============================================================================

# --- LLM "brain" (required for conversation) ---------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any chat-completions model works. gpt-4o-mini is cheap and fast.
JARVIS_LLM_MODEL=gpt-4o-mini

# Brain backend: openai | ollama | openclaw
# openclaw = delegate turns to OpenClaw gateway (gemma4 mesh on Primary)
JARVIS_BRAIN=openai

# Local Ollama (https://ollama.com). If JARVIS_OLLAMA_MODEL is set and
# JARVIS_BRAIN=openai, Ollama auto-wins unless you force openai.
JARVIS_OLLAMA_MODEL=gemma4:latest
OLLAMA_HOST=http://localhost:11434
# JARVIS_OLLAMA_HOST=http://localhost:11434   # legacy alias for OLLAMA_HOST

# --- OpenClaw / UnyKorn mesh (Primary PC) ------------------------------------
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# Must match gateway.auth.token in ~/.openclaw/openclaw.json (never commit)
OPENCLAW_GATEWAY_TOKEN=
JARVIS_OPENCLAW_AGENT=main

# --- Text-to-Speech (pick ONE; ElevenLabs sounds the most human) -------------
# 1) ElevenLabs (recommended for lifelike voice — same stack as DONK Live)
#    Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5

# 2) OpenAI TTS (good quality, uses OPENAI_API_KEY above).
JARVIS_OPENAI_TTS_VOICE=onyx
JARVIS_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Which TTS engine: "elevenlabs", "openai", or "pyttsx3" (offline).
JARVIS_TTS=auto

# --- Unykorn Browser daemon (optional) ---------------------------------------
# UNYKORN_DAEMON_PORT=8787
# UNYKORN_OPENCLAW_AGENT=main
# UNYKORN_BRAIN=auto
# "whisper-local" runs faster-whisper on your machine (no API cost).
# "whisper-api"   uses OpenAI's hosted Whisper (needs OPENAI_API_KEY).
JARVIS_STT=whisper-local
JARVIS_WHISPER_MODEL=base.en

# --- Wake word ---------------------------------------------------------------
# "openwakeword" listens continuously for "Hey Jarvis".
# "ptt" (push-to-talk) records when you press Enter.
# "off" disables mic input entirely (text chat only).
JARVIS_WAKE=ptt

# --- Personality -------------------------------------------------------------
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Sir

# Optional: inject FTH system context into the system prompt
# JARVIS_SYSTEM_CONTEXT=jarvis/system_context.txt
