# LLM (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Speech-to-text (OpenAI Whisper API)
# Uses OPENAI_API_KEY

# Text-to-speech: edge | openai | elevenlabs
TTS_PROVIDER=edge
EDGE_VOICE=en-GB-RyanNeural
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_MODEL=tts-1-hd
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Recording
SAMPLE_RATE=16000
RECORD_SECONDS=6
