# =============================================================
#  JARVIS — Environment Configuration
# =============================================================

# --- Required ---
# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# --- AI Model ---
# Recommended: gpt-4o (best), gpt-4o-mini (faster/cheaper)
OPENAI_MODEL=gpt-4o

# --- Voice Settings ---
# Neural voice for text-to-speech output
# Options (UK accent, like the movie Jarvis):
#   en-GB-RyanNeural     ← British male (default)
#   en-GB-ThomasNeural   ← British male (alternate)
#   en-US-GuyNeural      ← American male
#   en-US-AriaNeural     ← American female
#   en-GB-SoniaNeural    ← British female
VOICE_NAME=en-GB-RyanNeural

# Speech rate adjustment (+/- percentage)
VOICE_RATE=+5%

# --- Wake Word ---
# Say this phrase to activate Jarvis
WAKE_WORD=jarvis

# --- User Preferences ---
# How Jarvis addresses you
USER_NAME=sir

# City for weather lookups (e.g. "New York", "London")
DEFAULT_CITY=New York

# --- Input Mode ---
# voice  → microphone input, spoken output  (default)
# text   → keyboard input, spoken output
# silent → keyboard input, text-only output
INPUT_MODE=voice

# --- Optional: Weather API ---
# Leave blank to use the free wttr.in service
# Or add an OpenWeatherMap key for richer data
OPENWEATHERMAP_API_KEY=
